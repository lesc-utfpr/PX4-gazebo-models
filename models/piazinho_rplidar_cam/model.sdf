<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='piazinho_rplidar'>
    <include merge='true'>
      <uri>piazinho_mono_cam</uri>
    </include>
    <include merge='true'>
      <uri>model://rplidar_a3m1</uri>
      <pose relative_to="base_link">0 0 0.3 0 0 0</pose>
    </include>
    <joint name="LidarJoint" type="fixed">
      <parent>base_link</parent>
      <child>rplidar_a3m1/base_link</child>
    </joint>
    <include merge='true'>
      <uri>model://piazinho_lidar</uri>
      <pose relative_to="base_link">-0.058351 0.002478 0.077389 0 1.57079632679 0</pose>
    </include>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>
  </model>
</sdf>
